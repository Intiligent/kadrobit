APP_NAME=Kadrobit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://kadrobit.net

# Marketplace credentials: own key, not APP_KEY (config/credentials.php, docs/settings.md)
CREDENTIALS_KEY=
# CREDENTIALS_PREVIOUS_KEYS=
# CREDENTIALS_CONNECT_TIMEOUT=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kadrobit
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Passport keys: directory with oauth-private.key and oauth-public.key, relative to the project root
# or absolute. Created by `php artisan passport:keys` (or OauthSeeder) in this directory.
PASSPORT_KEY_PATH=storage
# Alternatively pass the key contents through the environment; they take precedence over the files.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Idempotency-Key handling (config/idempotency.php). Use redis in production to keep it off the database.
# IDEMPOTENCY_STORE=redis
# IDEMPOTENCY_TTL=3600
# IDEMPOTENCY_MAX_BODY_SIZE=65536

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ASSETS_UPLOAD_MAX_MB=200
ASSETS_UPLOAD_QUEUE=uploads
ASSETS_IMAGICK_THREADS=1
ASSETS_IMAGICK_MEMORY_MB=512
# Programs for video and vector previews: names from PATH locally, absolute paths on the server (docs/deploy.md)
ASSETS_FFMPEG=ffmpeg
ASSETS_FFPROBE=ffprobe
ASSETS_FFMPEG_THREADS=2
ASSETS_FFMPEG_TIMEOUT=240
ASSETS_RSVG_CONVERT=rsvg-convert
ASSETS_GHOSTSCRIPT=gs
ASSETS_VECTOR_TIMEOUT=120
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=kadrobit-private
R2_PUBLIC_BUCKET=kadrobit-public
R2_PUBLIC_URL=

# Cloudflare R2 (S3-compatible)
# Public CDN domain connected to the bucket (Cloudflare custom domain), no trailing slash

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=/oauth/google/callback

# Metadata generation (KB-38): key of the separate "kadrobit" project on platform.openai.com
OPENAI_API_KEY=
