APP_NAME=Kadrobit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://kadrobit.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kadrobit
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Passport keys: directory with oauth-private.key and oauth-public.key, relative to the project root
# or absolute. Created by `php artisan passport:keys` (or OauthSeeder) in this directory.
PASSPORT_KEY_PATH=storage
# Alternatively pass the key contents through the environment; they take precedence over the files.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Idempotency-Key handling (config/idempotency.php). Use redis in production to keep it off the database.
# IDEMPOTENCY_STORE=redis
# IDEMPOTENCY_TTL=3600
# IDEMPOTENCY_MAX_BODY_SIZE=65536

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ASSETS_DISK=s3

# Cloudflare R2 (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=kadrobit
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public CDN domain connected to the bucket (Cloudflare custom domain), no trailing slash
AWS_URL=

VITE_APP_NAME="${APP_NAME}"
