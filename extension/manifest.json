{
    "manifest_version": 3,
    "name": "Kadrobit",
    "description": "Finishes publishing your Kadrobit works on stock sites: finds the files, fills in the fields and submits them to review.",
    "version": "0.3.2",
    "key": "",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Kadrobit",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["@marketplaces"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "permissions": ["identity", "storage", "alarms"],
    "host_permissions": ["@kadrobit", "@marketplaces"]
}
